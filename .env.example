# 服务监听端口（ClawCloud / Render / Fly.io 会自动注入 PORT）
PORT=8787

# 客户端接入访问口令（必须修改为高强度随机字符串，与 Flutter 客户端内置密钥一致）
ACCESS_CODE=replace-with-strong-access-code

# SQLite 静态加密主密钥（AES-256-GCM，用于加密 Cookie 与 AI API Key，至少 32 字符）
ENCRYPTION_KEY=replace-with-at-least-32-chars-random-secret-key

# SQLite 数据持久化目录（Docker 部署时挂载持久化卷至此目录）
DATA_DIR=./data

# 珠科本学期第 1 周周一公历日期（YYYY-MM-DD，用于全客户端统一周次基准）
SEMESTER_START_MONDAY=2026-09-07

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
